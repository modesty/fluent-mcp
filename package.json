{
  "name": "@modesty/fluent-mcp",
  "version": "0.11.0",
  "description": "MCP server for Fluent (ServiceNow SDK)",
  "keywords": [
    "Servicenow SDK",
    "Fluent",
    "mcp",
    "MCP Server",
    "sdk",
    "model-context-protocol",
    "DSL",
    "domain specific language MCP"
  ],
  "author": {
    "name": "Modesty Zhang",
    "email": "modestyz@hotmail.com",
    "url": "https://www.google.com/search?q=modesty+zhang+site%3Acodeproject.com"
  },
  "homepage": "https://github.com/modesty/fluent-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modesty/fluent-mcp.git"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "fluent-mcp": "./dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "rollup -c rollup.config.mjs",
    "prebuild:dev": "node scripts/clean-dist.mjs",
    "build:dev": "rollup -c rollup.config.mjs --environment NODE_ENV:development",
    "dev:watch": "rollup -c rollup.config.mjs --environment NODE_ENV:development --watch",
    "start": "node dist/index.js",
    "dev": "npm run build:dev && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint 'src/**/*.ts' --config eslint.config.js",
    "lint:fix": "eslint 'src/**/*.ts' --config eslint.config.js --fix",
    "test": "node scripts/run-native-tests.mjs",
    "test:coverage": "node scripts/run-native-tests.mjs --coverage",
    "test:watch": "node scripts/run-native-tests.mjs --watch",
    "validate:snippets": "bash scripts/validate-snippets.sh",
    "validate:specs": "node scripts/validate-specs.mjs",
    "validate:instructs": "node scripts/validate-instructs.mjs",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "inspect": "npx -p @modelcontextprotocol/inspector@2.14.0 mcp-inspector node dist/index.js",
    "inspect:dev": "npm run build:dev && npx -p @modelcontextprotocol/inspector@2.14.0 mcp-inspector node dist/index.js",
    "inspect:published": "npx -p @modelcontextprotocol/inspector@2.14.0 mcp-inspector npx @modesty/fluent-mcp",
    "prepublishOnly": "npm run build && npm test"
  },
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=22.23.2",
    "npm": ">=10.9.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.8"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@servicenow/sdk": "4.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "rollup": "4.68.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "res"
  ]
}
